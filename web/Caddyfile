# Static file server for the built SPA (web image, internal port 80).
# TLS, security headers and the CSP live on the edge Caddy (infra/caddy/Caddyfile).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Vite emits content-hashed files under /assets: cache them for a year.
	# (Only when the file exists, so a 404 is never cached.)
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, favicon, SPA routes) must revalidate so deploys show up.
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	# A missing hashed asset is a real 404, never the SPA shell.
	handle /assets/* {
		file_server
	}

	# SPA fallback for client-side routes.
	handle {
		try_files {path} /index.html
		file_server
	}
}
