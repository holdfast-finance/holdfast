# Holdfast environment. Copy to .env with `make keys` (or `./scripts/dev.ps1 keys`), which fills
# the secrets below and sets the file to mode 600. Never commit .env.
#
# Comments sit on their own lines on purpose: inline comments after blank values parse
# differently across docker compose and python-dotenv.

# ---------------------------------------------------------------- Core
# dev | prod (| test, automated e2e stacks only; with E2E_HOOKS=true it serves /api/test/setup-token).
# prod disables /api/docs.
APP_ENV=dev
# self_host (default) | hosted. self_host reads credentials such as PLAID_SECRET_* from this file;
# hosted reads them from each household's encrypted settings row. Never both (ADR 0015).
APP_DEPLOYMENT=self_host
# true only on automated e2e stacks: with APP_ENV=test it mounts /api/test/* (setup-token hook).
# Ignored unless APP_ENV=test. Blank: false.
E2E_HOOKS=
# Public URL the browser uses, e.g. https://money.example.com in prod.
APP_BASE_URL=https://localhost
# Caddy site address (hostname only).
APP_HOST=localhost
# Host IP Caddy's :443 is published on in dev. Loopback only. Never 0.0.0.0.
CADDY_BIND=127.0.0.1
# Prod: the server's Tailscale IP (100.x.y.z). infra/docker-compose.prod.yml publishes :443 here.
TAILSCALE_BIND_IP=
# Prod: Cloudflare API token for DNS-01 certs only (Zone:DNS:Edit on APP_HOST's zone).
CF_API_TOKEN=
# Caddy upstream for the SPA. Leave blank: compose defaults to web:80 (dev override: web:5173).
WEB_UPSTREAM=

# ---------------------------------------------------------------- Secrets (scripts/gen-keys.py)
SESSION_SECRET=
FERNET_KEY=
# Postgres roles (infra/postgres/init/00-roles.sh, created on first db init):
#   POSTGRES_PASSWORD        holdfast_admin, the bootstrap superuser. Only the db image uses it.
#   POSTGRES_OWNER_PASSWORD  holdfast_owner, owns the schema and runs migrations (make migrate).
#   POSTGRES_APP_PASSWORD    holdfast_app, the api/worker runtime role (no superuser, no BYPASSRLS).
POSTGRES_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=

# ---------------------------------------------------------------- Data stores
# gen-keys.py replaces CHANGE_ME with POSTGRES_APP_PASSWORD / POSTGRES_OWNER_PASSWORD. A URL with
# no password gets it filled from the matching variable at runtime.
DATABASE_URL=postgresql+psycopg://holdfast_app:CHANGE_ME@db:5432/holdfast
MIGRATIONS_DATABASE_URL=postgresql+psycopg://holdfast_owner:CHANGE_ME@db:5432/holdfast
REDIS_URL=redis://redis:6379/0
# Path inside the api/worker containers (bind-mounted from ./data/documents).
DOCUMENT_STORE=/data/documents

# ---------------------------------------------------------------- Auth
# WebAuthn expected origin. Blank: https://APP_HOST. Set it only when the browser origin differs
# (e.g. a non-443 port). The RP id is always APP_HOST.
WEBAUTHN_ORIGIN=
# Comma-separated CIDRs whose X-Forwarded-For the API trusts (Caddy). Blank: loopback + the
# compose `frontend` network (172.30.10.0/24, pinned in docker-compose.yml). Set it only if you
# change that subnet or run the API behind a different proxy.
TRUSTED_PROXIES=

# ---------------------------------------------------------------- Plaid
# sandbox | production. Stays sandbox until you deliberately switch.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_PRODUCTS=transactions,auth,balance,investments,liabilities,statements
PLAID_COUNTRY_CODES=US
# e.g. https://money.example.com/plaid/oauth-return
PLAID_REDIRECT_URI=
# Optional; Holdfast polls by default (PLAN 7.4).
PLAID_WEBHOOK_URL=
PLAID_TX_DAYS_REQUESTED=730

# ---------------------------------------------------------------- SimpleFIN
# Fernet-encrypted when stored in the DB.
SIMPLEFIN_ACCESS_URL=

# ---------------------------------------------------------------- AI advisor
# anthropic | ollama | openai_compatible
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL_REVIEW=claude-opus-5-5
AGENT_MODEL_CHAT=claude-sonnet-5-5
AGENT_MONTHLY_TOKEN_BUDGET=2000000
OLLAMA_BASE_URL=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---------------------------------------------------------------- Notifications
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
NTFY_URL=
NTFY_TOPIC=

# ---------------------------------------------------------------- Household
# Two-letter state code for the tax module. Set yours; there is no default.
HOUSEHOLD_STATE=
HISTORY_START=2020-01-01

# ---------------------------------------------------------------- Feature flags
FEATURE_TAX=false
FEATURE_CRYPTO_SPEND=false
FEATURE_PUBLIC_SECTOR=false
