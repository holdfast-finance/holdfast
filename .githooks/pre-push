#!/usr/bin/env bash
# Holdfast pre-push: scan every commit being pushed, because a pushed branch on a public repo is
# already published. Runs for every seat (Keel, Anvil, Helm). ADR 0019, ADR 0039.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -z "$base" ]; then
    # No common base with origin/main (first push, orphan branch, missing remote): scan the whole
    # history. A bare sha includes the root commit; "root..sha" would skip it.
    echo "pre-push: no common base with origin/main; scanning the full history of $local_sha" >&2
    range=$local_sha
    scan_base=4b825dc642cb6eb9a060e54bf8d69288fbee4904  # the empty tree
  else
    range=$base..$local_sha
    scan_base=$base
  fi
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="--diff-merges=first-parent $range" "$root" >/dev/null 2>&1 ||
      { echo "pre-push: gitleaks flagged $range. Run: gitleaks git -v --log-opts=$range" >&2; status=1; }
  elif [ "${HOLDFAST_SKIP_GITLEAKS:-}" != "1" ]; then
    echo "pre-push: gitleaks is required (or set HOLDFAST_SKIP_GITLEAKS=1 once)" >&2; status=1
  fi
  scan="${HOLDFAST_PRIVATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/holdfast-private}/tools/scan_rev.py"
  "$root/scripts/check-private-data.sh" range "$range" || status=1
  if [ -f "$scan" ]; then
    python3 -I "$scan" "$root" "$scan_base" "$local_sha" >&2 ||
      { echo "pre-push: real-data scan flagged $range (file:line above)" >&2; status=1; }
  fi
done
exit $status
