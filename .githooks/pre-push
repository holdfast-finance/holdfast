#!/usr/bin/env bash
# Holdfast pre-push: scan every commit being pushed, because a pushed branch on a public repo is
# already published. Runs for every seat (Keel, Anvil, Helm). ADR 0019, ADR 0039.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  range=${base:+$base..}$local_sha
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" "$root" >/dev/null 2>&1 ||
      { echo "pre-push: gitleaks flagged $range. Run: gitleaks git -v --log-opts=$range" >&2; status=1; }
  elif [ "${HOLDFAST_SKIP_GITLEAKS:-}" != "1" ]; then
    echo "pre-push: gitleaks is required (or set HOLDFAST_SKIP_GITLEAKS=1 once)" >&2; status=1
  fi
  scan="${HOLDFAST_PRIVATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/holdfast-private}/tools/scan_rev.py"
  if [ -f "$scan" ] && [ -n "$base" ]; then
    python3 -I "$scan" "$root" "$base" "$local_sha" >&2 ||
      { echo "pre-push: real-data scan flagged $range (file:line above)" >&2; status=1; }
  fi
done
"$root/scripts/check-private-data.sh" || status=1
exit $status
