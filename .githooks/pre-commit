#!/usr/bin/env bash
# Holdfast pre-commit: secret scan + block private data. Enabled via `git config core.hooksPath .githooks`.
set -euo pipefail
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact -v >/dev/null 2>&1 || { echo "pre-commit: gitleaks found a possible secret. Run: gitleaks git --staged -v" >&2; exit 1; }
elif [ "${HOLDFAST_SKIP_GITLEAKS:-}" = "1" ]; then
  echo "pre-commit: gitleaks not installed; HOLDFAST_SKIP_GITLEAKS=1 set, skipping secret scan" >&2
else
  echo "pre-commit: gitleaks is required (see CONTRIBUTING.md). Install it, or set HOLDFAST_SKIP_GITLEAKS=1 to bypass once." >&2
  exit 1
fi
"$(git rev-parse --show-toplevel)/scripts/check-private-data.sh" staged
