# Holdfast edge proxy: dev / default. Local CA (`tls internal`), no ACME, no :80.
# Prod uses Caddyfile.prod (DNS-01 + Tailscale bind) via infra/docker-compose.prod.yml.
#
# The dev CSP adds 'unsafe-inline' (Vite's React-refresh preamble and injected <style> tags) and
# wss://{$APP_HOST} (Vite HMR through this proxy). The prod CSP in Caddyfile.prod has neither.
{
	admin localhost:2019
	auto_https disable_redirects
	skip_install_trust
}

{$APP_HOST:localhost} {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Swagger UI at /api/docs (dev only; disabled when APP_ENV=prod) loads from jsDelivr.
	@docs path /api/docs /api/docs/* /api/redoc
	header @docs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'"

	@notdocs not path /api/docs /api/docs/* /api/redoc
	header @notdocs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.plaid.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://cdn.plaid.com; connect-src 'self' https://*.plaid.com wss://{$APP_HOST:localhost}; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"

	# Cap request bodies (the API enforces the same 1 MiB limit as defense in depth).
	# X-Forwarded-For is overwritten with the real peer, never appended to a client-sent value.
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM:web:80}
	}
}
