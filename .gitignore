# Secrets — never commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.restic

# Private financial data — never commit
data/
exports/
*.ofx
*.qfx
TaxPackage_*.zip
# PDFs are blocked by default; only allow-listed brand/research docs and sanitized fixtures
*.pdf
!docs/brand/*.pdf
!docs/research/*.pdf
!backend/tests/fixtures/**/*.sanitized.pdf

